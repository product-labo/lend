{
  "name": "lend-scripts",
  "version": "1.0.0",
  "description": "Deployment and maintenance scripts for Lend contracts",
  "main": "index.js",
  "scripts": {
    "deploy": "ts-node deploy.ts",
    "typecheck": "tsc --noEmit",
    "gen:money": "ts-node gen-money.ts",
    "gen:money:check": "ts-node gen-money.ts --check",
    "test:env-docs": "node check-env-docs.test.mjs",
    "money:property-test": "tsx money-property-test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "axios": "1.13.5"
  }
}
